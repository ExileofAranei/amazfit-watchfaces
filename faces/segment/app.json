{
  "configVersion": "v3",
  "app": {
    "appId": 1080001,
    "appName": "SEGMENT",
    "appType": "watchface",
    "version": { "code": 1, "name": "0.1.0" },
    "vender": "ExileofAranei",
    "description": "Digital watchface for Amazfit Active Max, based on DM by larrabee777",
    "icon": "images/preview.png"
  },
  "permissions": ["data:user.hd.step"],
  "runtime": {
    "apiVersion": { "compatible": "2.1", "target": "2.1", "minVersion": "2.1" }
  },
  "targets": {
    "active-max": {
      "module": {
        "watchface": { "path": "watchface/index", "main": 1, "editable": 0, "lockscreen": 1 }
      },
      "platforms": [
        { "st": "r", "dw": 480, "deviceSource": 10813697 },
        { "st": "r", "dw": 480, "deviceSource": 10813699 }
      ],
      "designWidth": 480
    }
  },
  "i18n": {
    "ru-RU": { "appName": "SEGMENT" },
    "en-US": { "appName": "SEGMENT" }
  },
  "defaultLanguage": "en-US",
  "debug": false
}
