{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "lib": ["ES2020"],
    "types": ["node"]
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/types/**/*.d.ts", "faces/*/src/**/*.ts", "faces/*/*.config.ts"]
}
